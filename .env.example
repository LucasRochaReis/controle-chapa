# Modelo de variáveis de ambiente — copie para seu ambiente e ajuste os valores.
# Nao versione valores reais. O Spring Boot nao carrega este arquivo sozinho;
# defina as variaveis no sistema operacional ou na IDE.

# --- Banco de dados PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/controle_chapa
DB_USER=postgres
DB_PASSWORD=change-me

# --- Servidor ---
SERVER_PORT=6001
SERVER_CONTEXT_PATH=/controle_chapa

# --- Usuario administrador criado no primeiro boot ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
